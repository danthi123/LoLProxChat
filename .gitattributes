# Files executed on Linux CI runners must keep LF line endings regardless of a
# contributor's core.autocrlf setting — CRLF in a workflow run: block breaks the
# shell with `$'\r': command not found`.
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf

# Source is UTF-8 text, never binary. A stray control byte inside a string
# literal otherwise pushes a file past git's binary sniff, so it diffs as
# `Binary files differ` and neither review nor grep can see the change.
*.ts   text
